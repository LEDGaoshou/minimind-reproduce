{
  "train_batch_size": 4,
  "train_micro_batch_size_per_gpu": 2,
  "gradient_accumulation_steps": 1,
  "gradient_clipping": 1.0,
  "bf16": {
    "enabled": true
  },
  "zero_optimization": {
    "stage": 2,
    "contiguous_gradients": true,
    "overlap_comm": true,
    "reduce_scatter": true
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 3e-7,
      "betas": [0.9, 0.999],
      "eps": 1e-8,
      "weight_decay": 0.01
    }
  },
  "scheduler": {
    "type": "WarmupCosineLR",
    "params": {
      "total_num_steps": 1000,
      "warmup_min_ratio": 0.1,
      "warmup_num_steps": 2,
      "cos_min_ratio": 0.1,
      "warmup_type": "linear"
    }
  },
  "steps_per_print": 10,
  "wall_clock_breakdown": false
}
